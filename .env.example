# Admin authentication (server-only). Never prefix these with NEXT_PUBLIC_.
#
# Generate AUTH_SECRET (32+ random bytes, hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Generate ADMIN_PASSWORD_HASH from a plaintext password:
#   node -e "require('bcrypt').hash('YOUR_PASSWORD', 12).then(console.log)"
#
# In .env files, escape every $ in the bcrypt hash as \$.
# Next.js expands $VAR in dotenv files, which will corrupt $2b$12$... hashes.
# Example:
#   ADMIN_PASSWORD_HASH=\$2b\$12\$yourhash
#
# In Vercel/Netlify project settings, paste the hash as-is (no backslashes).

ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# GitHub (server-only). Fine-grained PAT for this repo.
# Contents: Read and write — required to upload images to public/images/.
# Do not grant unnecessary permissions.
# Never prefix these with NEXT_PUBLIC_.
#
# GITHUB_TOKEN=github_pat_...
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=brazil
# GITHUB_BRANCH=main

GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
